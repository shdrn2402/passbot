# --- Telegram Bot Configuration ---
# Get your TELEGRAM_TOKEN from @BotFather
TELEGRAM_TOKEN=your_bot_token_here

# Comma-separated list of Telegram User IDs allowed to use the bot
# You can find your ID using @userinfobot
ALLOWED_USER_IDS=123456789,987654321

# Master secret salt for password generation algorithm. 
# Keep this completely private. If changed, all generated passwords will change.
SECRET_KEY=your_random_master_secret
